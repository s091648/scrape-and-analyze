# frontend/Dockerfile.dev
# 本地開發用，程式碼透過 docker-compose volumes 掛載以支援 HMR

FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    graphviz \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libxshmfence1 \
    wget \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

# node_modules 與 Playwright 瀏覽器改由 named volume 持久化（見 docker-compose.yml），
# 不在建置期間安裝，避免跟 volume 內容重複烤進 image layer 造成 image 肥大。
# 容器啟動時偵測 volume 是否已有內容，沒有才安裝（僅首次啟動需要等待）。
# 程式碼透過 docker-compose volumes 掛載，不在此 COPY
CMD ["sh", "-c", "[ -d node_modules/next ] || npm install; [ -n \"$(ls -A /root/.cache/ms-playwright 2>/dev/null)\" ] || npx playwright install; exec npm run dev"]
