# frontend/Dockerfile.dev
# 本地開發用，程式碼透過 docker-compose volumes 掛載以支援 HMR

FROM node:20-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    graphviz \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libx11-xcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libxshmfence1 \
    wget \
    xdg-utils \
  && rm -rf /var/lib/apt/lists/*

# node_modules 與 Playwright 瀏覽器改由 named volume 持久化（見 docker-compose.yml），
# 不在建置期間安裝，避免跟 volume 內容重複烤進 image layer 造成 image 肥大。
# 容器啟動時安裝：npm install 用 node_modules 是否存在來判斷是否跳過，但 playwright install
# 每次都跑——它內部會比對已裝瀏覽器版本跟 playwright-core 版本，版本吻合時是快速 no-op，
# 版本不吻合（例如 package.json 升版但 volume 還留著舊版瀏覽器）才會真的重裝，
# 避免用「目錄非空」判斷是否跳過安裝而漏掉版本不吻合的情況。
# 程式碼透過 docker-compose volumes 掛載，不在此 COPY
CMD ["sh", "-c", "[ -d node_modules/next ] || npm install; npx playwright install; exec npm run dev"]
