FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    UV_SYSTEM_PYTHON=1

WORKDIR /app

# git: chatbot-plugin-sdk (backend group, 023-article-search follow-up) is a git-tag
# dependency — uv needs the git binary to fetch it, same reason src/Dockerfile* installs it.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Download MaxMind GeoLite2-City database — mirrors backend/Dockerfile's step so local dev
# gets the same geo_country/geo_city enrichment in RequestLoggingMiddleware's logs as
# production, instead of shared/utils/geoip.py silently no-op'ing on a missing /app/data/.
# No-ops (empty tar, geoip.py falls back to {} same as before) if MAXMIND_LICENSE_KEY is unset.
ARG MAXMIND_LICENSE_KEY
RUN apt-get update && apt-get install -y --no-install-recommends curl && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app/data && \
    if [ -n "$MAXMIND_LICENSE_KEY" ]; then \
      curl -sSL \
        "https://download.maxmind.com/app/geoip_download?edition_id=GeoLite2-City&license_key=${MAXMIND_LICENSE_KEY}&suffix=tar.gz" \
      | tar -xz --wildcards --strip-components=1 -C /app/data/ '*.mmdb'; \
    fi

COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv

# build context 為 project root，可取得 pyproject.toml 與 uv.lock
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --group backend --group observability --group dev

# 程式碼透過 docker compose volumes 掛載，不在此 COPY
CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
