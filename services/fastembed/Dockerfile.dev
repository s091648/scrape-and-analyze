FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    FASTEMBED_CACHE_PATH=/app/.fastembed_cache \
    PATH=/app/.venv/bin:$PATH

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.10.12 /uv /usr/local/bin/uv

RUN uv venv .venv && \
    uv pip install fastapi "uvicorn[standard]" "fastembed>=0.3"

# 預先下載模型到 image layer 裡，避免每次啟動都重新下載
ARG EMBED_SPARSE_MODEL=prithivida/Splade_PP_en_v1
ARG EMBED_DENSE_MODEL=

RUN set -eu; \
    cache="$FASTEMBED_CACHE_PATH"; \
    mkdir -p "$cache"; \
    if [ -n "$EMBED_SPARSE_MODEL" ]; then \
        echo "Downloading sparse model: $EMBED_SPARSE_MODEL"; \
        .venv/bin/python -c "from fastembed import SparseTextEmbedding; SparseTextEmbedding('$EMBED_SPARSE_MODEL', cache_dir='$cache')"; \
    fi; \
    if [ -n "$EMBED_DENSE_MODEL" ]; then \
        echo "Downloading dense model: $EMBED_DENSE_MODEL"; \
        .venv/bin/python -c "from fastembed import TextEmbedding; TextEmbedding('$EMBED_DENSE_MODEL', cache_dir='$cache')"; \
    fi

EXPOSE 8080

# main.py 透過 docker-compose volume 掛載，--reload 支援 hot-reload
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
