# ---------------------------------------------------------------------------
# infra/terraform/secrets/production.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/production.tfvars  (git-ignored). Overlaid AFTER shared.tfvars.
# In CI: == GitHub Actions secret TF_TFVARS_PRODUCTION (base64).
# ---------------------------------------------------------------------------

app_env                = "production"
railway_environment_id = ""   # production Railway environment UUID


# --- per-environment values (weekly-report R2 bucket/URL differ per env) ---
r2_bucket_name = ""
r2_public_url  = ""

# Auth signing key (HS256) shared by dashboard_frontend NEXTAUTH_SECRET and
# dashboard_backend NEXTAUTH_SECRET. MUST differ from staging's. Generate with
# `openssl rand -base64 32`. Rotating logs everyone out.
nextauth_secret = ""

# --- environment-scoped GitHub Actions secrets (scraper / production) ---
gh_env_database_url  = ""
gh_env_railway_token = ""

# --- environment-scoped GitHub Actions variable (scraper / production) ---
gh_env_frontend_url = ""   # public production frontend URL, audited by lighthouse.yml (manual dispatch)
