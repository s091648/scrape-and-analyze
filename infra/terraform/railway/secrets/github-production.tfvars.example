# infra/terraform/railway/secrets/github-production.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/github-production.tfvars  (git-ignored). Overlaid AFTER
# github-shared.tfvars. Consumed by Terraform (github-ci.tf) — the env-scoped
# "scraper / production" GitHub Actions secrets/variable. Also read by
# scripts/push_railway_variables.py (app_env, gh_env_railway_token).
#
# In CI: == GitHub Actions secret TF_TFVARS_GITHUB_PRODUCTION (base64).
# ---------------------------------------------------------------------------

app_env = "production"

# environment-scoped GitHub Actions secrets (scraper / production)
gh_env_database_url  = ""
gh_env_railway_token = ""   # environment-scoped project token (NOT account-level) — also used by push_railway_variables.py

# environment-scoped GitHub Actions variable (scraper / production)
gh_env_frontend_url = ""    # public production frontend URL, audited by lighthouse.yml on manual dispatch
