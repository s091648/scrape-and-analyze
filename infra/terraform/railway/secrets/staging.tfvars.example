# ---------------------------------------------------------------------------
# infra/terraform/secrets/staging.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/staging.tfvars  (git-ignored). Overlaid AFTER shared.tfvars
# (later -var-file wins), so put here anything that differs for staging or is
# staging-only. In CI: == GitHub Actions secret TF_TFVARS_STAGING (base64).
# ---------------------------------------------------------------------------

app_env                = "staging"
railway_environment_id = ""   # staging Railway environment UUID

# --- per-environment values (weekly-report R2 bucket/URL differ per env) ---
r2_bucket_name = ""
r2_public_url  = ""

# Auth signing key (HS256) shared by dashboard_frontend NEXTAUTH_SECRET and
# dashboard_backend NEXTAUTH_SECRET. MUST differ from production's. Generate with
# `openssl rand -base64 32`. Rotating logs everyone out.
nextauth_secret = ""

# --- environment-scoped GitHub Actions secrets (scraper / staging) ---
gh_env_database_url  = ""
gh_env_railway_token = ""   # the environment-scoped project token (NOT account-level)

# --- environment-scoped GitHub Actions variable (scraper / staging) ---
gh_env_frontend_url = ""   # public staging frontend URL, audited by lighthouse.yml
