# ---------------------------------------------------------------------------
# infra/terraform/secrets/shared.tfvars.example  (TRACKED — keys only, no values)
#
# Copy to  secrets/shared.tfvars  (git-ignored) and fill in real values.
# This layer holds values common to BOTH environments. Anything that differs
# per environment goes in secrets/staging.tfvars / secrets/production.tfvars
# instead (later -var-file wins) — any key can move between files freely, the
# variable declarations in variables.tf don't care which file supplies it.
#
# In CI this file's real content == GitHub Actions secret TF_TFVARS_SHARED
# (base64). Sync all three with:  make push-tfvars
#
# Railway reference strings MUST escape the leading `$` so HCL doesn't try to
# interpolate:   redis_url = "$${{ Redis.REDIS_URL }}"
# `scripts/pull_railway_variables.py --as-tfvars` does this escaping for you.
# ---------------------------------------------------------------------------

github_owner      = ""
github_repository = ""

# Railway project ID — not consumed by any resource, but scripts/generate_terraform_imports.py
# needs it for the one-time import ID. Safe to leave here (non-secret UUID).
railway_project_id = ""

# --- Railway service IDs (stable UUIDs; same in both environments) ---
service_id_dashboard_backend  = ""
service_id_dashboard_frontend = ""
service_id_storybook          = ""
service_id_scrape_and_analyze = ""
service_id_chatbot_plugin     = ""
service_id_fastembed          = ""
service_id_weekly_report      = ""
service_id_refresh_metrics    = ""
service_id_rag_backfill       = ""
service_id_dedup_reconcile    = ""

# --- observability: Grafana Cloud ---
grafana_api_key       = ""
grafana_loki_url      = ""
grafana_loki_user     = ""
grafana_otlp_endpoint = ""
grafana_otlp_user     = ""
grafana_prometheus_url  = ""
grafana_prometheus_user = ""

# --- error tracking ---
sentry_dsn = ""

# --- rag_dense ---
rag_dense_api_key_env = ""
rag_dense_dimension   = ""
rag_dense_model       = ""
rag_dense_provider    = ""
rag_dense_rpd         = ""
rag_dense_rpm         = ""
rag_dense_tpm         = ""
rag_gemini_api_key    = ""
rag_dense_endpoint_url = ""

# --- rag_sparse ---
rag_sparse_dimension = ""
rag_sparse_model     = ""
rag_sparse_provider  = ""
rag_sparse_rpd       = ""
rag_sparse_rpm       = ""
rag_sparse_tpm       = ""
rag_sparse_endpoint_url = ""

# --- vector DB ---
database_url       = "$${{Postgres.DATABASE_URL}}"
vector_db_host     = ""
vector_db_name     = ""
vector_db_password = ""
vector_db_port     = ""
vector_db_schema   = ""
vector_db_user     = ""

# --- rag chunking ---
rag_chunk_overlap    = ""
rag_chunk_size       = ""
rag_embed_batch_size = ""

# --- notifications ---
telegram_bot_token = ""
telegram_chat_id   = ""
fixie_url          = ""

# --- other shared secrets ---
gemini_api_key       = ""
openrouter_api_key   = ""
github_package_token = ""

# --- per-service values with a common value across environments ---
chat_service_api_key       = ""
chat_service_url           = ""
# public frontend URL WITH scheme — feeds FRONTEND_ORIGIN (backend CORS +
# weekly-report links) AND NEXTAUTH_URL (frontend). e.g.
# "https://$${{dashboard-frontend.RAILWAY_PUBLIC_DOMAIN}}"
frontend_public_url        = ""
backend_url                = ""
maxmind_license_key        = ""
# nextauth_secret is per-environment (auth signing key — staging & production
# MUST differ). See staging.tfvars / production.tfvars.
redis_url                  = ""   # e.g. "$${{ Redis.REDIS_URL }}"
cache_redis_url            = ""
search_index_redis_url     = ""
swagger_try_it_out_enabled = ""
grafana_tempo_url          = ""
grafana_tempo_user         = ""

google_client_id     = ""
google_client_secret = ""
grafana_sa_token     = ""
grafana_url          = ""

chatbot_max_tokens = ""

search_autocomplete_max_query_len = ""
search_min_doc_freq               = ""

hf_token             = ""
r2_access_key_id     = ""
r2_account_id        = ""
r2_secret_access_key = ""
resend_api_key       = ""
resend_from_email    = ""

contact_email = ""

uv_group_weekly_report   = ""
uv_group_refresh_metrics = ""
uv_group_rag_backfill    = ""
uv_group_dedup_reconcile = ""


# --- GitHub Actions repo-level secrets (ci.yml / release.yml) ---
gh_claude_api_key     = ""
# gh_codecov_token      = ""
gh_gemini_api_key     = ""
gh_gist_id            = ""
gh_gist_secret        = ""
gh_nextauth_secret    = ""
gh_npm_token          = ""
gh_openrouter_api_key = ""
gh_release_pat        = ""

# --- GitHub Actions repo-level (non-secret) variables ---
gh_var_backend_url   = ""
gh_var_storybook_url = ""
# gh_env_frontend_url is per-environment — see staging.tfvars / production.tfvars
