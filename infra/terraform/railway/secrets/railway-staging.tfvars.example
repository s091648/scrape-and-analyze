# infra/terraform/railway/secrets/railway-staging.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/railway-staging.tfvars  (git-ignored). Overlaid AFTER
# railway-shared.tfvars. Railway service env-var values that differ for staging.
# Pushed by scripts/push_railway_variables.py; NOT read by Terraform.
#
# In CI: == GitHub Actions secret TF_TFVARS_RAILWAY_STAGING (base64).
# ---------------------------------------------------------------------------

# Auth signing key (HS256) — dashboard_frontend + dashboard_backend NEXTAUTH_SECRET.
# MUST differ from production's. Generate with `openssl rand -base64 32`.
nextauth_secret = ""

# weekly-report R2 bucket differs per environment
r2_bucket_name = ""
r2_public_url  = ""
