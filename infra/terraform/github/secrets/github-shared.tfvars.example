# infra/terraform/github/secrets/github-shared.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/github-shared.tfvars  (git-ignored). Consumed by Terraform
# (github-ci.tf) — the repo-level GitHub Actions secrets/variables that don't
# differ per environment. Also read by scripts/push_railway_variables.py for
# service_id_* / the Railway token.
#
# In CI: this file == GitHub Actions secret TF_TFVARS_GITHUB_SHARED (base64).
# Sync all six github-*/railway-* files with:  make push-tfvars
# ---------------------------------------------------------------------------

github_owner      = ""
github_repository = ""

# --- Railway service IDs (stable UUIDs; same in both environments) ---
service_id_dashboard_backend  = ""
service_id_dashboard_frontend = ""
service_id_storybook          = ""
service_id_scrape_and_analyze = ""
service_id_chatbot_plugin     = ""
service_id_fastembed          = ""
service_id_weekly_report      = ""
service_id_refresh_metrics    = ""
service_id_rag_backfill       = ""
service_id_dedup_reconcile    = ""

# --- repo-level GitHub Actions secrets (ci.yml / release.yml) ---
gh_claude_api_key     = ""
# gh_codecov_token    = ""   # org allows tokenless upload; leave commented
gh_gemini_api_key     = ""
gh_gist_id            = ""
gh_gist_secret        = ""
gh_nextauth_secret    = ""
gh_npm_token          = ""
gh_openrouter_api_key = ""
gh_release_pat        = ""

# --- repo-level GitHub Actions (non-secret) variables ---
gh_var_backend_url   = ""
gh_var_storybook_url = ""
