# infra/terraform/github/secrets/github-staging.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/github-staging.tfvars  (git-ignored). Overlaid AFTER
# github-shared.tfvars. Consumed by Terraform (github-ci.tf) — the env-scoped
# "scraper / staging" GitHub Actions secrets/variable. Also read by
# scripts/push_railway_variables.py (app_env, gh_env_railway_token).
#
# In CI: == GitHub Actions secret TF_TFVARS_GITHUB_STAGING (base64).
# ---------------------------------------------------------------------------

app_env = "staging"

# environment-scoped GitHub Actions secrets (scraper / staging)
gh_env_database_url  = ""
gh_env_railway_token = ""   # environment-scoped project token (NOT account-level) — also used by push_railway_variables.py

# environment-scoped GitHub Actions variable (scraper / staging)
gh_env_frontend_url = ""    # public staging frontend URL, audited by lighthouse.yml
