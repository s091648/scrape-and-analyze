# infra/terraform/github/secrets/railway-shared.tfvars.example  (TRACKED — keys only)
#
# Copy to  secrets/railway-shared.tfvars  (git-ignored). NOT read by Terraform —
# scripts/push_railway_variables.py resolves these against railway-services.json
# and pushes them to each Railway service via the `railway` CLI. Values common to
# BOTH environments; per-environment ones go in railway-<env>.tfvars.
#
# Railway reference strings MUST escape the leading `$` so nothing interpolates:
#   redis_url = "$${{ Redis.REDIS_URL }}"
# `scripts/pull_railway_variables.py --as-tfvars` does this escaping for you.
#
# In CI: == GitHub Actions secret TF_TFVARS_RAILWAY_SHARED (base64).
# ---------------------------------------------------------------------------

# Railway project ID (non-secret UUID) — used to scope the `railway` CLI calls.
railway_project_id = ""

# --- observability: Grafana Cloud ---
grafana_api_key         = ""
grafana_loki_url        = ""
grafana_loki_user       = ""
grafana_otlp_endpoint   = ""
grafana_otlp_user       = ""
grafana_prometheus_url  = ""
grafana_prometheus_user = ""
grafana_tempo_url       = ""
grafana_tempo_user      = ""
grafana_sa_token        = ""
grafana_url             = ""

# --- error tracking ---
sentry_dsn = ""

# --- rag_dense ---
rag_dense_api_key_env  = ""
rag_dense_dimension    = ""
rag_dense_model        = ""
rag_dense_provider     = ""
rag_dense_rpd          = ""
rag_dense_rpm          = ""
rag_dense_tpm          = ""
rag_gemini_api_key     = ""
rag_dense_endpoint_url = ""

# --- rag_sparse ---
rag_sparse_dimension    = ""
rag_sparse_model        = ""
rag_sparse_provider     = ""
rag_sparse_rpd          = ""
rag_sparse_rpm          = ""
rag_sparse_tpm          = ""
rag_sparse_endpoint_url = ""   # e.g. "http://$${{fastembed.RAILWAY_PRIVATE_DOMAIN}}:8080"

# --- vector DB ---
database_url       = "$${{Postgres.DATABASE_URL}}"
vector_db_host     = ""
vector_db_name     = ""
vector_db_password = ""
vector_db_port     = ""
vector_db_schema   = ""
vector_db_user     = ""

# --- rag chunking ---
rag_chunk_overlap    = ""
rag_chunk_size       = ""
rag_embed_batch_size = ""

# --- notifications ---
telegram_bot_token = ""
telegram_chat_id   = ""
fixie_url          = ""

# --- other shared secrets ---
gemini_api_key       = ""
openrouter_api_key   = ""
github_package_token = ""

# --- per-service values with a common value across environments ---
chat_service_api_key = ""
chat_service_url     = ""   # e.g. "http://$${{chatbot-plugin.RAILWAY_PRIVATE_DOMAIN}}:8080"
# public frontend URL WITH scheme — feeds FRONTEND_ORIGIN (backend CORS +
# weekly-report links) AND NEXTAUTH_URL (frontend). e.g.
# "https://$${{dashboard-frontend.RAILWAY_PUBLIC_DOMAIN}}"
frontend_public_url        = ""
backend_url                = ""   # e.g. "$${{dashboard-backend.RAILWAY_PRIVATE_DOMAIN}}"
maxmind_license_key        = ""
redis_url                  = ""   # e.g. "$${{ Redis.REDIS_URL }}"
cache_redis_url            = ""
search_index_redis_url     = ""
swagger_try_it_out_enabled = ""

google_client_id     = ""
google_client_secret = ""

chatbot_max_tokens = ""

search_autocomplete_max_query_len = ""
search_min_doc_freq               = ""

hf_token             = ""
r2_access_key_id     = ""
r2_account_id        = ""
r2_secret_access_key = ""
resend_api_key       = ""
resend_from_email    = ""

contact_email = ""

uv_group_weekly_report   = ""
uv_group_refresh_metrics = ""
uv_group_rag_backfill    = ""
uv_group_dedup_reconcile = ""
