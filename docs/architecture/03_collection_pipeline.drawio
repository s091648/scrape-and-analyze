        <mxCell id="pipeline" value="CollectionPipeline" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#fff2cc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="240" height="200" as="geometry" />
        </mxCell>
        <mxCell id="pipeline_con" value="* Phase 1: Discover
  get_active_due() -> ScraperSettings
  scraper.discover() -> ScrapeJobs
* Phase 1.5: Pre-Dedup
  find_analyzed_url_hashes()
* Phase 2: Fetch
  ScrapeExecutor.run(tasks)
* Phase 3: Publish DTOs
  event_bus.publish(ScrapedArticleDTO)
* Phase 4: Completion
  PipelineCompletedEvent -> handlers" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10" vertex="1" parent="pipeline">
          <mxGeometry y="40" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="executor" value="ScrapeExecutor" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#fff2cc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="executor_con" value="Two-Phase Concurrent Fetch

Phase 1: Route
  QueueRouter.route(tasks)
  -> per-host HostQueueMap

Phase 2: Execute
  ThreadPoolExecutor(num_workers)
  _try_claim() -> BoundedSemaphore(1)
  task.execute() -> ScrapedArticle

Config:
  num_workers=5, delay=5.0s" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10" vertex="1" parent="executor">
          <mxGeometry y="40" width="240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="host_queue" value="HostQueueMap" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=40;fillColor=#ffe6cc;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="hq_con" value="* queues: Dict[str, Queue]
  per-host request queue
* semaphores: Dict[str, BoundedSemaphore(1)]
  max 1 concurrent request per host" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=10" vertex="1" parent="host_queue">
