                </mxCell>
                <mxCell id="e_log_rt" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="mw_log" target="mw_routes" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="jwt_guard" value="require_admin (JWT Guard)&#xa;HTTPBearer - decode - verify exp + role=admin&#xa;401 invalid / 403 wrong role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="30" y="230" width="260" height="55" as="geometry"/>
