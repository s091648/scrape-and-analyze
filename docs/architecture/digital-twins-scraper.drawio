                    <mxGeometry x="30" y="55" width="260" height="45" as="geometry"/>
                </mxCell>
                <mxCell id="mw_log" value="RequestLoggingMiddleware&#xa;structlog + X-Request-ID header" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="30" y="110" width="260" height="45" as="geometry"/>
