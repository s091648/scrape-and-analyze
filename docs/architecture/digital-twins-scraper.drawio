                </mxCell>
                <mxCell id="ep_health" value="GET /health (DB ping)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="340" y="55" width="160" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="ep_articles" value="GET /articles&#xa;GET /articles/{id}&#xa;GET /failed-tasks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="340" y="110" width="160" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="ep_graph" value="GET /analyses/graph&#xa;GET /analyses/graph/tag/{tag}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
