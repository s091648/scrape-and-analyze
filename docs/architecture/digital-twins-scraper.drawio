                </mxCell>

                <!-- frontend service -->
                <mxCell id="svc_frontend" value="frontend&#xa;(Next.js)&#xa;Port: 3000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="640" y="60" width="160" height="70" as="geometry"/>
                </mxCell>

                <!-- app -> postgres arrow -->
                <mxCell id="edge_app_pg" value="connects / runs migrations" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="svc_app" target="svc_postgres" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- backend -> postgres arrow -->
                <mxCell id="edge_be_pg" value="queries DB" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=1;entryY=0.8;entryDx=0;entryDy=0;" parent="1" source="svc_backend" target="svc_postgres" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- Alembic Migration Chain -->
                <mxCell id="mig_title" value="Alembic Migration Chain" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="180" width="300" height="30" as="geometry"/>
                </mxCell>

                <mxCell id="mig_baseline" value="baseline&#xa;(no-op stamp)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="40" y="220" width="150" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="mig_auth" value="create_auth_schema&#xa;(auth schema + auth.users)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="220" y="220" width="170" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="mig_scraper" value="create_scraper_settings&#xa;(scraper_settings + seeds)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="420" y="220" width="180" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="mig_admin" value="seed_admin&#xa;(bcrypt admin user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="630" y="220" width="150" height="50" as="geometry"/>
                </mxCell>

                <mxCell id="edge_m1" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="mig_baseline" target="mig_auth" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_m2" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="mig_auth" target="mig_scraper" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="edge_m3" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="mig_scraper" target="mig_admin" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <!-- DB Tables -->
                <mxCell id="tbl_title" value="New Database Tables" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="40" y="310" width="300" height="30" as="geometry"/>
                </mxCell>

                <!-- auth.users table -->
                <mxCell id="tbl_auth" value="auth.users&#xa;---&#xa;id: UUID (PK)&#xa;username: VARCHAR(100) UNIQUE&#xa;hashed_password: TEXT&#xa;role: VARCHAR(20) default=admin&#xa;created_at: TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="350" width="240" height="110" as="geometry"/>
                </mxCell>

                <!-- scraper_settings table -->
                <mxCell id="tbl_scraper" value="scraper_settings&#xa;---&#xa;id: UUID (PK)&#xa;source_type: VARCHAR(20) [rss|blog]&#xa;name: VARCHAR(100)&#xa;url: TEXT&#xa;frequency: VARCHAR(20) [daily|weekly]&#xa;is_active: BOOLEAN&#xa;selector_config: JSONB&#xa;created_at / updated_at: TIMESTAMPTZ" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="320" y="350" width="280" height="130" as="geometry"/>
                </mxCell>

                <!-- app service runs migrations note -->
                <mxCell id="note_app" value="app service runs: alembic upgrade head" style="text;html=1;strokeColor=#d6b656;fillColor=#FFF9C4;align=center;fontSize=10;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="240" y="160" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="edge_app_note" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="svc_app" target="note_app" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="dash_ph2" name="Dashboard Ph2 - FastAPI Backend">
        <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
