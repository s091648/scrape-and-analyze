                <mxCell id="switch_comp" value="Switch (shadcn/ui)&#xa;checked={s.is_active}&#xa;onCheckedChange: toggleActive(id, v)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="620" y="90" width="220" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="optimistic_update" value="Optimistic state update (immediate)&#xa;setSettings(prev =&gt; prev.map(s =&gt;&#xa;  s.id === id ? { ...s, is_active } : s))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="620" y="165" width="220" height="55" as="geometry"/>
                </mxCell>
                <mxCell id="patch_settings" value="PATCH /scraper-settings/{id} (async)&#xa;{ is_active } JSON body&#xa;Authorization: Bearer &lt;JWT&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="620" y="240" width="220" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="e_switch_opt" style="edgeStyle=orthogonalEdgeStyle;html=1;" parent="1" source="switch_comp" target="optimistic_update" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_opt_patch" value="async" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" parent="1" source="optimistic_update" target="patch_settings" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="sys_overview" value="Full System (Admin use case)&#xa;Browser → middleware.ts (route match)&#xa;→ ScraperSettingsPage (session guard)&#xa;→ ScraperSourceForm / Switch&#xa;→ apiFetch (Authorization: Bearer JWT)&#xa;→ FastAPI require_admin + CRUD&#xa;→ scraper_settings table (PostgreSQL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="320" y="310" width="280" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>