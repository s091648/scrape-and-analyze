# ===========================================
# Digital Twins Scraper - Git Ignore
# ===========================================

# -----------------------------
# Environment & Secrets
# -----------------------------
/.env
/.env.local
/.env.*.local
/.env.development
/.env.staging
/.env.production
/infra/terraform/.env.local
# Remote state lives in HCP Terraform, not locally — .terraform/ is just the
# local provider plugin cache; terraform.tfvars and .terraform.lock.hcl ARE
# committed on purpose (non-secret values / provider version pins).
infra/terraform/**/.terraform/
infra/terraform/**/*.tfstate
infra/terraform/**/*.tfstate.*
infra/terraform/**/crash.log
infra/terraform/**/*.auto.tfvars
*.pem
*.key
credentials.json

# -----------------------------
# Python
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
!frontend/lib/
!frontend/scripts/lib/
!.github/scripts/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json

# Virtual environments
venv/
ENV/
env/
.venv/

