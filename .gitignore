# -----------------------------
node_modules/
cdk.out/
*.js.map
*.d.ts
!jest.config.js
!cdk.json

# CDK context
cdk.context.json

# -----------------------------
# IDE & Editor
# -----------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

