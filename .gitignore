# -----------------------------
.claude/
.worktrees/
docs/
openspec/

# -----------------------------
# VitePress docs site (site/)
# -----------------------------
site/specs/
site/constitution.md
site/.vitepress/cache/
site/guide/architecture/terraform-modules/

# -----------------------------
# Speckit local-only planning artifacts (not committed)
# -----------------------------
specs/*/research.md
specs/*/quickstart.md

# -----------------------------
# Local development files
# -----------------------------
db_dumps/
migrations/
lighthouse-reports/

# Playwright MCP browser-testing artifacts (screenshots, snapshots, console logs)
.playwright-mcp/
# .railway/ — Railway IaC scratch: fresh per-env pulls for comparison + CI plan pins.
# The unified .railway/railway.ts and the .railway/railway.<env>.ts references stay tracked.
.railway/pulled.*.ts
.railway/.railway.ts.keep
.railway/railway-plan*.json
