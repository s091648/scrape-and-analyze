    "intelligence.weekly_reports" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>weekly_reports</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">topic_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">week_start_date</td><td align="left"><font point-size="10">Date</font></td></tr><tr><td align="left">title</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">summary_text</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">cover_image_url</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">article_ids</td><td align="left"><font point-size="10">JSONB</font></td></tr><tr><td align="left">article_count</td><td align="left"><font point-size="10">Integer</font></td></tr><tr><td align="left">status</td><td align="left"><font point-size="10">String(20)</font></td></tr><tr><td align="left">error_message</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">updated_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
