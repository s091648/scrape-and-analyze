    "intelligence.article_tags" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>article_tags</b></font></td></tr><tr><td align="left">🔑 article_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">🔑 tag_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr></table>>];
    "intelligence.tag_group_definitions" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>tag_group_definitions</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">name</td><td align="left"><font point-size="10">String(100)</font></td></tr><tr><td align="left">display_name</td><td align="left"><font point-size="10">String(100)</font></td></tr><tr><td align="left">description</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">color_hex</td><td align="left"><font point-size="10">String(7)</font></td></tr><tr><td align="left">sort_order</td><td align="left"><font point-size="10">Integer</font></td></tr><tr><td align="left">topic_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">embedding</td><td align="left"><font point-size="10">Vector(768)</font></td></tr></table>>];
    "intelligence.tag_group_definitions_translation" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>tag_group_definitions_translation</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">tag_group_definition_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">language</td><td align="left"><font point-size="10">String(10)</font></td></tr><tr><td align="left">display_name</td><td align="left"><font point-size="10">String(200)</font></td></tr><tr><td align="left">description</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
