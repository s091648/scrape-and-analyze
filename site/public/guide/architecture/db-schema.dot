digraph db_schema {
  rankdir="LR";
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=10];

  subgraph "cluster_core" {
    label="core"; style=filled; color="#77AADD"; fontname="Helvetica"; fontsize=14;
    "core.articles" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>articles</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">url</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">url_hash</td><td align="left"><font point-size="10">String(64)</font></td></tr><tr><td align="left">source</td><td align="left"><font point-size="10">String(50)</font></td></tr><tr><td align="left">title</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">content</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">published_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">scraped_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">metadata_</td><td align="left"><font point-size="10">JSONB</font></td></tr><tr><td align="left">correlation_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">topic_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">original_source</td><td align="left"><font point-size="10">String(200)</font></td></tr><tr><td align="left">has_vectors</td><td align="left"><font point-size="10">Boolean</font></td></tr></table>>];
    "core.articles_translation" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>articles_translation</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">article_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">language</td><td align="left"><font point-size="10">String(10)</font></td></tr><tr><td align="left">title</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">content</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">updated_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
    "core.topics" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>topics</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">name</td><td align="left"><font point-size="10">String(100)</font></td></tr><tr><td align="left">display_name</td><td align="left"><font point-size="10">String(200)</font></td></tr><tr><td align="left">description</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">color_hex</td><td align="left"><font point-size="10">String(7)</font></td></tr><tr><td align="left">prompt_override</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">sort_order</td><td align="left"><font point-size="10">Integer</font></td></tr><tr><td align="left">is_active</td><td align="left"><font point-size="10">Boolean</font></td></tr><tr><td align="left">tag_mode</td><td align="left"><font point-size="10">String(20)</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
  }

  subgraph "cluster_collection" {
    label="collection"; style=filled; color="#BBCC33"; fontname="Helvetica"; fontsize=14;
    "collection.article_metric_values" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>article_metric_values</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">article_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">metric_key</td><td align="left"><font point-size="10">String(50)</font></td></tr><tr><td align="left">value</td><td align="left"><font point-size="10">Numeric</font></td></tr><tr><td align="left">last_flushed_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">updated_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
    "collection.article_metrics" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>article_metrics</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">article_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">view_count</td><td align="left"><font point-size="10">Integer</font></td></tr><tr><td align="left">last_flushed_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">updated_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
    "collection.failed_tasks" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>failed_tasks</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">task_type</td><td align="left"><font point-size="10">String(50)</font></td></tr><tr><td align="left">article_url</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">article_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">analysis_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">exception_type</td><td align="left"><font point-size="10">String(200)</font></td></tr><tr><td align="left">exception_message</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">context</td><td align="left"><font point-size="10">JSONB</font></td></tr><tr><td align="left">traceback</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">failed_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">correlation_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">resolved</td><td align="left"><font point-size="10">Boolean</font></td></tr><tr><td align="left">resolved_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
    "collection.scraper_keywords" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>scraper_keywords</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">topic_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">keyword_type</td><td align="left"><font point-size="10">String(30)</font></td></tr><tr><td align="left">keyword</td><td align="left"><font point-size="10">String(500)</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
    "collection.scraper_settings" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>scraper_settings</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">source_type</td><td align="left"><font point-size="10">String(20)</font></td></tr><tr><td align="left">name</td><td align="left"><font point-size="10">String(100)</font></td></tr><tr><td align="left">url</td><td align="left"><font point-size="10">Text</font></td></tr><tr><td align="left">frequency</td><td align="left"><font point-size="10">Integer</font></td></tr><tr><td align="left">is_active</td><td align="left"><font point-size="10">Boolean</font></td></tr><tr><td align="left">selector_config</td><td align="left"><font point-size="10">SelectorConfigColumn</font></td></tr><tr><td align="left">last_scraped_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">topic_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">created_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">updated_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr></table>>];
  }

  subgraph "cluster_intelligence" {
    label="intelligence"; style=filled; color="#EEDD88"; fontname="Helvetica"; fontsize=14;
    "intelligence.analyses" [label=<<table border="1" cellborder="0" cellspacing="0" bgcolor="white"><tr><td colspan="2" bgcolor="#333333"><font color="white"><b>analyses</b></font></td></tr><tr><td align="left">🔑 id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">article_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">correlation_id</td><td align="left"><font point-size="10">UUID(as_uuid=True)</font></td></tr><tr><td align="left">analyzed_at</td><td align="left"><font point-size="10">DateTime(timezone=True)</font></td></tr><tr><td align="left">model_used</td><td align="left"><font point-size="10">String(100)</font></td></tr><tr><td align="left">input_tokens</td><td align="left"><font point-size="10">Integer</font></td></tr><tr><td align="left">output_tokens</td><td align="left"><font point-size="10">Integer</font></td></tr></table>>];
