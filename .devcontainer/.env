# ── Database ──
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/postgres
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# ── Backend API ──
FRONTEND_ORIGIN=http://localhost:3000
NEXTAUTH_SECRET=codespaces-dev-secret-do-not-use-in-prod
NEXTAUTH_URL=http://localhost:3000
# Note: FRONTEND_ORIGIN, NEXTAUTH_URL are overridden by docker-compose.codespaces.yml
# environment: section using ${CODESPACE_NAME}
ADMIN_PASSWORD=admin

# ── Frontend ──
BACKEND_URL=http://backend:8000

# ── LLM Providers (set real keys via Codespaces Secrets) ──
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
MAXMIND_LICENSE_KEY=

# ── Google OAuth (set via Codespaces Secrets) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Observability (disabled for Codespaces) ──
SENTRY_DSN=
GRAFANA_LOKI_URL=
GRAFANA_OTLP_ENDPOINT=

# ── Notifications (disabled for Codespaces) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
