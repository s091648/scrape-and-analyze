# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Providers
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
MAXMIND_LICENSE_KEY=

# Backend API + shared auth secret
NEXTAUTH_SECRET=
FRONTEND_ORIGIN=
ADMIN_PASSWORD=
# SWAGGER_TRY_IT_OUT_ENABLED: controls whether the backend's live /docs Swagger UI allows
# executing real requests ("Try it out"). Defaults to disabled (false) everywhere, including
# in the docs site's read-only API Docs page embed (BACKEND_URL below), which iframes this
# same /docs endpoint. Set to "true" only as a deliberate opt-in (e.g. a staging backend).
SWAGGER_TRY_IT_OUT_ENABLED=

# Frontend
# BACKEND_URL: server-side only (Next.js API routes → backend). Uses Docker/Railway internal hostname.
# Also read by src/ (CacheWarmupHandler, 020-redis-caching-layer) to re-warm the cache via
# real HTTP calls to backend after a scrape run — same internal hostname, same default.
#   Local Docker:  http://backend:8000
#   Railway:       http://<backend-service-name>.railway.internal:8000
BACKEND_URL=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_PACKAGE_TOKEN=

# RAG / Chat Service
# Set VECTOR_DB_NAME/USER/PASSWORD to enable RAG ingestion.
# Embedding providers are configured via RAG_DENSE_* / RAG_SPARSE_* env vars below.
REDIS_URL=
# Separate logical DB (default db 1 vs REDIS_URL's db 0) for disposable cache-aside
# entries only — safe to FLUSHDB without touching REDIS_URL's durable view-count/
# rate-limit state. See backend/config.py / src/config/settings.py.
CACHE_REDIS_URL=
CHAT_SERVICE_URL=
CHAT_SERVICE_API_KEY=

# Article Search & Autocomplete (023-article-search)
# Query-time dense/sparse embedding (GET /search) reuses the same RAG_DENSE_*/RAG_SPARSE_*
# block below that src/'s RAG ingestion pipeline configures — backend/ now reads it too
# (backend/services/search_service.py), so the query vector always lands in the same space
# as the article vectors already stored via ingestion. Retired SEARCH_EMBEDDING_ENDPOINT_URL
# (the old fastembed-only, dense-less var this replaced).
# Separate logical DB (default db 2) for the autocomplete prefix index — distinct from
# REDIS_URL (db 0, durable operational state) and CACHE_REDIS_URL (db 1, disposable
# read-through cache) so a full rebuild can safely FLUSHDB/SWAPDB without touching either.
# RESERVED SLOT: RedisSearchIndexGateway.rebuild() also uses (this DB's index + 1) — e.g.
# db 3 if this is db 2 — as an internal swap buffer (shared/search_index/redis_gateway.py).
# That db index is derived in code, not its own env var, but it is claimed: never point
# another Redis consumer at it, or rebuild()'s FLUSHDB/SWAPDB will silently corrupt its
# data (see specs/023-article-search/research.md Post-Ship Addendum).
SEARCH_INDEX_REDIS_URL=
# Longest (suffix-)prefix indexed per term (research.md's cap "C"). Must match on both the
# rebuild job (src/) and the autocomplete endpoint (backend/) — frontend also reads this
# value (build-time constant, kept in sync manually) to skip firing requests past this length.
SEARCH_AUTOCOMPLETE_MAX_QUERY_LEN=8
# Minimum document frequency (distinct articles) for a term to be indexed — filters
# rare/incidental words out of the autocomplete vocabulary.
SEARCH_MIN_DOC_FREQ=2
RAG_GEMINI_API_KEY=
CHATBOT_MAX_TOKENS=

# Chatbot Plugin tuning
GEMINI_MODEL=
GEMINI_RPM=
CHATBOT_MAX_CONTEXT_CHUNKS=
CHATBOT_RETRIEVAL_MIN_SCORE=
CHATBOT_RERANKER_MIN_SCORE=

# Fastembed Service (fastembed/) — shared by scraper and chatbot-plugin
# EMBED_SPARSE_MODEL / EMBED_DENSE_MODEL control which models the fastembed
# container loads. These are independent of RAG_SPARSE_MODEL (which only matters
# when RAG_SPARSE_PROVIDER=local, i.e. in-process embedding).
EMBED_SPARSE_MODEL=
EMBED_SPARSE_BATCH_SIZE=
EMBED_DENSE_MODEL=
EMBED_DENSE_BATCH_SIZE=

# RAG embedding providers — shared by src/ (ingestion), chatbot-plugin (chat retrieval),
# and backend/ (GET /search query embedding, 023-article-search follow-up). All three
# MUST use identical values here — that's what keeps query and article vectors in the
# same space. Stays env-var-based deliberately (not DB-driven like llm_providers): some
# of these are also build-time Docker ARGs (fastembed's, and RAG_DENSE_MODEL/
# RAG_SPARSE_MODEL here when the provider is "local") that bake a model's weights into
# an image layer before any DB connection exists — switching a deployment between
# provider_type="local" (weights baked in, larger image, no external call) and
# "endpoint"/"gemini" (smaller image, calls out) is a build-time decision, not something
# a DB row can express.
# Dense: "gemini" (API-based) or "local" (fastembed, no API key needed) or "endpoint" or "huggingface"
RAG_DENSE_PROVIDER=
RAG_DENSE_MODEL=
RAG_DENSE_DIMENSION=
# Name of the env var that holds the actual API key (only for provider_type=gemini/endpoint)
RAG_DENSE_API_KEY_ENV=
RAG_DENSE_ENDPOINT_URL=
RAG_DENSE_RPM=
RAG_DENSE_TPM=
RAG_DENSE_RPD=
# Gemini only: on a per-minute TOKEN quota (TPM) 429, split the batch in half and
# retry each half instead of just waiting. Unset/false keeps the default wait-and-retry.
RAG_DENSE_SPLIT_BATCH_ON_TPM=
# Sparse: "endpoint" (recommended — use the shared fastembed service) or "local"
RAG_SPARSE_PROVIDER=
RAG_SPARSE_MODEL=
RAG_SPARSE_DIMENSION=
# Docker / Railway internal hostname for the fastembed service
RAG_SPARSE_ENDPOINT_URL=
RAG_SPARSE_RPM=
RAG_SPARSE_TPM=
RAG_SPARSE_RPD=
# Chunks packed into one embed() API call. Google gemini-embedding-001 supports up to 100
# inputs per call; 96 keeps most articles (≤80 chunks) in 1 request. Default: 96.
RAG_EMBED_BATCH_SIZE=96
# Chunking parameters — ingest only, no effect on retrieve.
# step = RAG_CHUNK_SIZE - RAG_CHUNK_OVERLAP (characters advanced per chunk).
# Default (500/50 → step 450): a 36,000-char article → ~80 chunks.
# Recommended (1500/150 → step 1350): same article → ~27 chunks (fits in 1 embed call).
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=150
# Max concurrent RAG-ingesting articles in the live pipeline (each holds a real
# Postgres connection — NullPool, no pooling). Size against Postgres's own
# max_connections headroom, not RAG_DENSE_RPM. Default: 10.
RAG_DISPATCH_CONCURRENCY=10
# fastembed model cache directory.
# Local: leave unset — Dockerfile.dev ENV sets /app/.fastembed_cache and docker-compose
#        mounts a named volume there, so models persist across container restarts.
# Railway (image-baked models): leave unset — production Dockerfile ENV sets the same path.
# Railway (Volume, Pro plan): set to the Volume mount path (e.g. /mnt/fastembed).
FASTEMBED_CACHE_PATH=

# Vector DB credentials — typically the same as POSTGRES_* unless using a dedicated vector DB
VECTOR_DB_NAME=
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=
VECTOR_DB_HOST=
VECTOR_DB_PORT=
# PostgreSQL schema for vector tables (default: vectors)
VECTOR_DB_SCHEMA=
# Table names within the vector schema (defaults match SDK defaults)
VECTOR_DB_ARTICLES_TABLE=
VECTOR_DB_CHUNKS_TABLE=

# Observability
# APP_ENV: controls the environment label on all traces, logs, and metrics.
# Set to "local" for local development, "production" for Railway deployments.
APP_ENV=
# Shared by both backend (backend/main.py) and frontend (frontend/instrumentation-client.ts,
# exposed to the client bundle via frontend/next.config.ts's `env`) — one Sentry project,
# split by the SDK's automatic `platform` tag (python vs javascript).
SENTRY_DSN=
# OTel ingest (OTLP/HTTP → Grafana Cloud Tempo). Do NOT append /v1/traces — code adds it automatically.
# Format: https://otlp-gateway-prod-{region}.grafana.net/otlp
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
# Loki push endpoint (for structured log shipping from backend/frontend)
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# Datasource query base URLs (for monitoring dashboard charts — Grafana Cloud free tier)
# Format: https://prometheus-prod-{id}.grafana.net/api/prom
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
# Format: https://tempo-prod-{id}.grafana.net
GRAFANA_TEMPO_URL=
GRAFANA_TEMPO_USER=
# Grafana Cloud stack base URL (e.g. https://mystack.grafana.net) — used for SSRF allowlist
GRAFANA_URL=
GRAFANA_API_KEY=
# GRAFANA_LOKI_URL: base URL without /push suffix. Code appends /push for ingest, /query_range for query.
# Service Account token (glsa_) — used only by grafana-embed route to call Grafana's panel render API.
# NOT used for datasource queries (those use GRAFANA_API_KEY via backend /grafana/* endpoints).
GRAFANA_SA_TOKEN=

# Proxy
FIXIE_URL=

# Migration job for local development
REMOTE_RAILWAY_DB_URL=
REMOTE_RAILWAY_STAGING_DB_URL=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot identity (used in User-Agent and From header to identify the scraper)
CONTACT_EMAIL=

# Cloudflare R2 (blob storage for weekly report cover images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email (Resend — https://resend.com, free tier 3000 emails/month)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# View count flush interval (seconds; how often Redis view counts are synced to PostgreSQL)
VIEW_COUNT_FLUSH_INTERVAL=900

# Terraform token
TF_API_TOKEN=
TF_GITHUB_TOKEN=