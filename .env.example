# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=
DATABASE_URL=
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=

# Providers
GEMINI_API_KEY=
CLAUDE_API_KEY=
OPENROUTER_API_KEY=
MAXMIND_LICENSE_KEY=

# Backend API + shared auth secret
NEXTAUTH_SECRET=
FRONTEND_ORIGIN=
ADMIN_PASSWORD=

# Frontend
# BACKEND_URL: server-side only (Next.js API routes → backend). Uses Docker/Railway internal hostname.
#   Local Docker:  http://backend:8000
#   Railway:       http://<backend-service-name>.railway.internal:8000
BACKEND_URL=
# NEXT_PUBLIC_BACKEND_URL: client-side (browser → backend). Must be publicly reachable.
#   Local Docker:  http://localhost:8000
#   Railway:       https://<backend-service-name>.up.railway.app
NEXT_PUBLIC_BACKEND_URL=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_PACKAGE_TOKEN=

# RAG / Chat Service
# Set VECTOR_DB_NAME/USER/PASSWORD to enable RAG ingestion.
# Embedding providers are configured via RAG_DENSE_* / RAG_SPARSE_* env vars below.
REDIS_URL=
CHAT_SERVICE_URL=
CHAT_SERVICE_API_KEY=
RAG_GEMINI_API_KEY=
CHATBOT_MAX_TOKENS=

# Chatbot Plugin tuning
GEMINI_MODEL=gemini-2.5-flash
GEMINI_RPM=60
CHATBOT_MAX_CONTEXT_CHUNKS=10
CHATBOT_MAX_TOKENS=2048
CHATBOT_RETRIEVAL_MIN_SCORE=0.0
CHATBOT_RERANKER_MIN_SCORE=0.0

# Fastembed Service (services/fastembed) — shared by scraper and chatbot-plugin
# EMBED_SPARSE_MODEL / EMBED_DENSE_MODEL control which models the fastembed
# container loads. These are independent of RAG_SPARSE_MODEL (which only matters
# when RAG_SPARSE_PROVIDER=local, i.e. in-process embedding).
EMBED_SPARSE_MODEL=prithivida/Splade_PP_en_v1
EMBED_SPARSE_BATCH_SIZE=8
EMBED_DENSE_MODEL=
EMBED_DENSE_BATCH_SIZE=32

# RAG embedding providers
# Dense: "gemini" (API-based) or "local" (fastembed, no API key needed) or "endpoint"
RAG_DENSE_PROVIDER=gemini
RAG_DENSE_MODEL=gemini-embedding-001
RAG_DENSE_DIMENSION=768
# Name of the env var that holds the actual API key (only for provider_type=gemini/endpoint)
RAG_DENSE_API_KEY_ENV=RAG_GEMINI_API_KEY
RAG_DENSE_ENDPOINT_URL=
RAG_DENSE_RPM=
RAG_DENSE_TPM=
RAG_DENSE_RPD=
# Sparse: "endpoint" (recommended — use the shared fastembed service) or "local"
RAG_SPARSE_PROVIDER=endpoint
RAG_SPARSE_MODEL=prithivida/Splade_PP_en_v1
RAG_SPARSE_DIMENSION=30522
# Docker / Railway internal hostname for the fastembed service
RAG_SPARSE_ENDPOINT_URL=http://fastembed:8080
RAG_SPARSE_RPM=
RAG_SPARSE_TPM=
RAG_SPARSE_RPD=
# fastembed model cache directory.
# Local: leave unset — Dockerfile.dev ENV sets /app/.fastembed_cache and docker-compose
#        mounts a named volume there, so models persist across container restarts.
# Railway (image-baked models): leave unset — production Dockerfile ENV sets the same path.
# Railway (Volume, Pro plan): set to the Volume mount path (e.g. /mnt/fastembed).
FASTEMBED_CACHE_PATH=

# Vector DB credentials — typically the same as POSTGRES_* unless using a dedicated vector DB
VECTOR_DB_NAME=
VECTOR_DB_USER=
VECTOR_DB_PASSWORD=
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=5432
# PostgreSQL schema for vector tables (default: vectors)
VECTOR_DB_SCHEMA=vectors
# Table names within the vector schema (defaults match SDK defaults)
VECTOR_DB_ARTICLES_TABLE=articles
VECTOR_DB_CHUNKS_TABLE=article_chunks

# Observability
# APP_ENV: controls the environment label on all traces, logs, and metrics.
# Set to "local" for local development, "production" for Railway deployments.
APP_ENV=
SENTRY_DSN=
# OTel ingest (OTLP/HTTP → Grafana Cloud Tempo). Do NOT append /v1/traces — code adds it automatically.
# Format: https://otlp-gateway-prod-{region}.grafana.net/otlp
GRAFANA_OTLP_ENDPOINT=
GRAFANA_OTLP_USER=
# Loki push endpoint (for structured log shipping from backend/frontend)
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
# Datasource query base URLs (for monitoring dashboard charts — Grafana Cloud free tier)
# Format: https://prometheus-prod-{id}.grafana.net/api/prom
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USER=
# Format: https://tempo-prod-{id}.grafana.net
GRAFANA_TEMPO_URL=
GRAFANA_TEMPO_USER=
# Grafana Cloud stack base URL (e.g. https://mystack.grafana.net) — used for SSRF allowlist
GRAFANA_URL=
GRAFANA_API_KEY=
# GRAFANA_LOKI_URL: base URL without /push suffix. Code appends /push for ingest, /query_range for query.
# Service Account token (glsa_) — used only by grafana-embed route to call Grafana's panel render API.
# NOT used for datasource queries (those use GRAFANA_API_KEY via backend /grafana/* endpoints).
GRAFANA_SA_TOKEN=

# Proxy
FIXIE_URL=

# Migration job for local development
REMOTE_RAILWAY_DB_URL=
REMOTE_RAILWAY_STAGING_DB_URL=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bot identity (used in User-Agent and From header to identify the scraper)
CONTACT_EMAIL=