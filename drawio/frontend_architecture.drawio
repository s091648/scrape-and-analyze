        <mxCell id="c_api_nextauth" value="&lt;p style='margin:0;padding:4px;text-align:center;'&gt;&lt;b&gt;/api/auth/[...nextauth]&lt;/b&gt;&lt;/p&gt;&lt;hr size='1'/&gt;&lt;p style='margin:0;padding:2px 4px;font-size:10px;'&gt;route.ts&lt;br/&gt;+ GET: NextAuth handler&lt;br/&gt;+ POST: NextAuth handler&lt;br/&gt;— Credentials + Google auth&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
