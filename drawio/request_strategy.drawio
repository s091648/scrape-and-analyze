        <mxCell id="p1-b1bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Barrier 1 &#8212; Text stage (concurrent, per-article)" vertex="1">
          <mxGeometry x="40" y="730" width="460" height="370" as="geometry" />
        </mxCell>
        <mxCell id="p1-b2bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Barrier 2 &#8212; RAG ingestion (concurrent, detached)" vertex="1">
