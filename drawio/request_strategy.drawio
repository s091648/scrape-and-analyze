        </mxCell>
        <mxCell id="p1-gather2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="asyncio.gather(*rag_tasks, return_exceptions=True) &#8212; settle semantics" vertex="1">
