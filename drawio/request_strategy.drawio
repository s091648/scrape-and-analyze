  </diagram>

  <diagram name="4. Async Concurrency &amp; DB Pool" id="rs-page4-async">
    <mxGraphModel dx="1174" dy="685" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p4-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" value="Async Pipeline Concurrency, Barriers &amp; DB Pool" vertex="1">
          <mxGeometry x="40" y="16" width="920" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p4-gate1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="_text_stage_semaphore&lt;br&gt;BoundedSemaphore(TEXT_STAGE_CONCURRENCY=8)&lt;br&gt;gates entry to the per-article text stage &#8212; holds a pooled DB connection + runs the LLM chain" vertex="1">
          <mxGeometry x="40" y="70" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-gate2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="_rag_dispatch_semaphore&lt;br&gt;BoundedSemaphore(RAG_DISPATCH_CONCURRENCY=4)&lt;br&gt;gates entry to the RAG task BODY, not task creation &#8212; a waiting task holds no session yet" vertex="1">
          <mxGeometry x="540" y="70" width="460" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p4-invariant" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=middle;" value="Manual invariant (comment-only, not asserted at runtime): TEXT_STAGE(8) + RAG_DISPATCH(4) = 12 &#8804; ASYNC_DB_POOL_SIZE(10) + ASYNC_DB_MAX_OVERFLOW(10) = 20" vertex="1">
          <mxGeometry x="40" y="200" width="960" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p4-b1bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Barrier 1 &#8212; text stage" vertex="1">
          <mxGeometry x="40" y="290" width="460" height="260" as="geometry" />
        </mxCell>
        <mxCell id="p4-b2bg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Barrier 2 &#8212; RAG ingestion" vertex="1">
          <mxGeometry x="540" y="290" width="460" height="260" as="geometry" />
        </mxCell>

        <mxCell id="p4-gather1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="asyncio.gather(*text_tasks, return_exceptions=True)&lt;br&gt;settle semantics &#8212; one slow/failed article never blocks the rest &#8594; TextPipelineCompletedEvent (see p.1)" vertex="1">
          <mxGeometry x="60" y="330" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-latch1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" value="_ArticleSpanLatch.mark_text()&lt;br&gt;article.pipeline span ends only once BOTH mark_text() + mark_rag() have fired (either order) &#8212; single event loop, no lock needed" vertex="1">
          <mxGeometry x="60" y="440" width="420" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p4-dispatch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="RAG dispatched via asyncio.create_task() &#8212; detached, never awaited inline" vertex="1">
