  <diagram name="1. Pipeline Overview" id="rs-page1-overview">
    <mxGraphModel dx="1174" dy="685" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" value="Scraper Pipeline &#8212; Request / Concurrency Overview" vertex="1">
          <mxGeometry x="40" y="16" width="820" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p1-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#666666;" value="src/entrypoints/cli/main.py &#8594; CollectionPipeline.run()" vertex="1">
          <mxGeometry x="40" y="48" width="820" height="20" as="geometry" />
        </mxCell>

        <mxCell id="p1-guard" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=middle;" value="main.py process guard&lt;br&gt;Startup jitter: random 0&#8211;180s (skipped if RUN_IMMEDIATELY=1) &#8594; asyncio.run(_build_and_run()) &#8594; 50-min MAX_EXECUTION_TIME soft cap via asyncio.timeout() around pipeline.run()" vertex="1">
          <mxGeometry x="40" y="80" width="920" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p1-seqbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Batched &amp; sequential (024-async-pipeline-refactor FR-003)" vertex="1">
          <mxGeometry x="40" y="160" width="340" height="420" as="geometry" />
        </mxCell>

        <mxCell id="p1-discover" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9312; Discover&lt;br&gt;ScrapeExecutor.run_discover()&lt;br&gt;thread pool &#8804;5 (dynamic: min(5,#hosts))&lt;br&gt;per-host BoundedSemaphore(1)&lt;br&gt;per-domain token bucket (rate_limiter.py)" vertex="1">
          <mxGeometry x="60" y="200" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-fetch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9313; Fetch&lt;br&gt;ScrapeExecutor.run_fetch_only()&lt;br&gt;5 fetch worker threads&lt;br&gt;fetch_delay = 5.0s / worker&lt;br&gt;robots.txt respected (blogs)" vertex="1">
          <mxGeometry x="60" y="320" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p1-dedup" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9314; Pre-dedup&lt;br&gt;UrlHash dedup &#8212; applied pre-fetch (discover filter) + post-fetch (pipeline.dedup span, also collapses within-batch dupes)&lt;br&gt;batched, synchronous" vertex="1">
          <mxGeometry x="60" y="440" width="300" height="100" as="geometry" />
        </mxCell>

        <mxCell id="p1-e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p1-discover" target="p1-fetch">
