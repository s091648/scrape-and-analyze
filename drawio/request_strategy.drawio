  <diagram name="2. HTTP Rate Limiting" id="rs-page2-http">
    <mxGraphModel dx="1174" dy="685" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p2-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" value="Outbound HTTP Rate Limiting &amp; Scrape Concurrency" vertex="1">
          <mxGeometry x="40" y="16" width="920" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p2-leftbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="DomainRateLimiter &#8212; src/infrastructure/shared/http/rate_limiter.py" vertex="1">
          <mxGeometry x="40" y="70" width="460" height="850" as="geometry" />
        </mxCell>
        <mxCell id="p2-rightbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="ScrapeExecutor &#8212; src/infrastructure/collection/executor/" vertex="1">
          <mxGeometry x="540" y="70" width="460" height="850" as="geometry" />
        </mxCell>

        <mxCell id="p2-seq1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="acquire(domain)&lt;br&gt;&#9312; raise_if_tripped() &#8212; fail fast if this domain already saw a 429 this run" vertex="1">
          <mxGeometry x="60" y="120" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-seq2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9313; _TokenBucket.acquire()&lt;br&gt;blocks until 1 token available&lt;br&gt;refill = rpm/60 tokens/s, starts with 1 token&lt;br&gt;polls is_tripped() every 1s while waiting (_TRIP_POLL_INTERVAL_SECONDS)" vertex="1">
          <mxGeometry x="60" y="210" width="420" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p2-seq3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9314; connection(): semaphore.acquire()&lt;br&gt;arXiv domains (export.arxiv.org, arxiv.org): Semaphore(1) &#8212; TOS&lt;br&gt;all other domains: Semaphore(10)" vertex="1">
          <mxGeometry x="60" y="330" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-seq4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9315; raise_if_tripped() again &#8212; catches a trip that happened while this call was waiting on the bucket" vertex="1">
          <mxGeometry x="60" y="430" width="420" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p2-e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-seq1" target="p2-seq2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-seq2" target="p2-seq3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e3" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-seq3" target="p2-seq4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2-rpm" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=middle;" value="Default RPM overrides&lt;br&gt;&#8226; general: 10&lt;br&gt;&#8226; export.arxiv.org / arxiv.org: 3 (TOS &#8804;1 req/3s, shared IP budget)&lt;br&gt;&#8226; api.semanticscholar.org: 1 (unauth ~100/day &#8594; &#8804;50 in a 50-min run)&lt;br&gt;&#8226; api.openalex.org: 300 (&#8776;5 rps; polite pool allows 10 rps)&lt;br&gt;&#8226; known anti-bot sites (e.g. iotworldtoday.com): 2" vertex="1">
          <mxGeometry x="60" y="530" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p2-circuit" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="Circuit breaker&lt;br&gt;note_rate_limited() on any 429 &#8594; DomainCircuitOpenError for the rest of this process (external quota/pool exhaustion won't recover mid-run)" vertex="1">
          <mxGeometry x="60" y="700" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-thread" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" value="Thread-safe throughout &#8212; threading.Lock guards each bucket + the tripped-domain set" vertex="1">
          <mxGeometry x="60" y="810" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="p2-r1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="ThreadPoolExecutor&lt;br&gt;5 fetch workers + up to 5 discover workers&lt;br&gt;discover workers = min(5, #distinct hosts due this run)" vertex="1">
          <mxGeometry x="560" y="120" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-r2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="fetch_delay = 5.0s &#8212; sleep per worker after each fetch" vertex="1">
          <mxGeometry x="560" y="230" width="420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2-r3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="HostQueueMap&lt;br&gt;1 Queue + BoundedSemaphore(1) per host &#8594; at most 1 in-flight request per host" vertex="1">
          <mxGeometry x="560" y="310" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-r4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="WeightedRoundRobinQueueSelector (default)&lt;br&gt;drains the host with the deepest backlog first&lt;br&gt;RoundRobinQueueSelector also exists, currently unused" vertex="1">
          <mxGeometry x="560" y="410" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-r5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="_try_claim()&lt;br&gt;non-blocking semaphore.acquire(blocking=False) + polling loop (time.sleep(0.05))" vertex="1">
          <mxGeometry x="560" y="520" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-r6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="RateLimitedProviderTracker&lt;br&gt;a host's first 429 &#8594; mark_exhausted() &#8594; remaining discover tasks for that host are skipped for the rest of this run" vertex="1">
          <mxGeometry x="560" y="620" width="420" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2-r7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" value="contextvars.copy_context()&lt;br&gt;propagates OTel span context into each worker thread (needed on Python &lt; 3.12)" vertex="1">
          <mxGeometry x="560" y="730" width="420" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2-e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-r1" target="p2-r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e5" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-r2" target="p2-r3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e6" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-r3" target="p2-r4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e7" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-r4" target="p2-r5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2-e8" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p2-r5" target="p2-r6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p2-footer" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=middle;" value="discover / fetch / pre-dedup stay batched &amp; sequential (024-async-pipeline-refactor FR-003) &#8212; each phase is bridged into the async CollectionPipeline via asyncio.to_thread() so it never blocks the event loop (see p.1)" vertex="1">
          <mxGeometry x="40" y="940" width="960" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3. LLM Quota &amp; Provider Chain" id="rs-page3-llm">
    <mxGraphModel dx="1174" dy="685" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1030" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontStyle=1;fontSize=22;" value="LLM / Embedding Quota &amp; Provider Resilience Chain" vertex="1">
          <mxGeometry x="40" y="16" width="920" height="34" as="geometry" />
        </mxCell>

        <mxCell id="p3-swbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="SlidingWindowStrategy &#8212; per-provider quota (rate_limit/sliding_window_strategy.py)" vertex="1">
          <mxGeometry x="40" y="70" width="960" height="320" as="geometry" />
        </mxCell>

        <mxCell id="p3-s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="Rolling 60s window&lt;br&gt;RPM: timestamp deque&lt;br&gt;TPM: (timestamp, tokens) deque" vertex="1">
          <mxGeometry x="60" y="110" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="Hard daily cap (RPD)&lt;br&gt;_daily_count &#8805; rpd &#8594; raise RateLimitExhausted" vertex="1">
          <mxGeometry x="370" y="110" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" value="threading.Lock&lt;br&gt;makes check-and-reserve atomic (_compute_wait)" vertex="1">
          <mxGeometry x="680" y="110" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="acquire()&lt;br&gt;blocking sleep-loop until wait() returns 0" vertex="1">
          <mxGeometry x="60" y="220" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="try_acquire() / has_capacity()&lt;br&gt;non-blocking reserve-if-available / side-effect-free peek" vertex="1">
          <mxGeometry x="370" y="220" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3-s6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="Token estimate: len(content)//4&lt;br&gt;(rough &#8212; biased for non-English / code); NoOpStrategy for unlimited providers" vertex="1">
          <mxGeometry x="680" y="220" width="290" height="90" as="geometry" />
        </mxCell>

        <mxCell id="p3-chainbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Provider resilience chain &#8212; resilient_llm_service.py" vertex="1">
          <mxGeometry x="40" y="420" width="960" height="430" as="geometry" />
        </mxCell>

        <mxCell id="p3-p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="ResilientLLMService (sync)&lt;br&gt;used by: weekly-report / release-notes / tag-embedding backfill&lt;br&gt;handlers sorted by priority, tried in order&lt;br&gt;&#9888; file's own comment: NOT concurrency-safe &#8212; no ProviderSelector" vertex="1">
          <mxGeometry x="60" y="460" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="AsyncResilientLLMService (async)&lt;br&gt;used by build_collection_pipeline() only&lt;br&gt;same priority-fallback shape + capacity-aware dispatch" vertex="1">
          <mxGeometry x="540" y="460" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="On RateLimitExhausted:&lt;br&gt;handlers.remove(handler); handlers.append(handler)&lt;br&gt;&#8594; demoted to end of list; tracked in exhausted_providers (used in completion notification)" vertex="1">
          <mxGeometry x="60" y="580" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p3-p4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="ProviderSelector.select() &#8594; _dispatch_order()&lt;br&gt;handlers with has_capacity() dispatched first, remaining handlers appended in priority order&lt;br&gt;&#8594; spreads concurrent article tasks across every model with headroom instead of queuing behind priority #1" vertex="1">
          <mxGeometry x="540" y="580" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="Non-blocking-first pattern&lt;br&gt;try_acquire() sync on the event-loop thread first (atomic vs. other gather tasks)&lt;br&gt;only on a miss: await asyncio.to_thread(strategy.acquire) (blocking, offloaded)" vertex="1">
          <mxGeometry x="540" y="700" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p3-p6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="Other exceptions:&lt;br&gt;logged, falls through to the next handler in this pass (not demoted &#8212; only RateLimitExhausted demotes)" vertex="1">
          <mxGeometry x="60" y="700" width="460" height="110" as="geometry" />
        </mxCell>

        <mxCell id="p3-e1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p3-p1" target="p3-p3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3-e2" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p3-p3" target="p3-p6">
