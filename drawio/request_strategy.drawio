        <mxCell id="p3-e4" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;" edge="1" source="p3-p4" target="p3-p5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p3-footer" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=6;verticalAlign=middle;" value="Same shape reused for:&lt;br&gt;&#8226; Embedding provider chain (ResilientEmbeddingService / async sibling)&lt;br&gt;&#8226; Metrics provider chain (OpenAlex / Semantic Scholar) &#8212; NOT interchangeable; priority orders which provider *can* answer (identifier coverage), not a pure rate-limit fallback" vertex="1">
          <mxGeometry x="40" y="880" width="960" height="90" as="geometry" />
        </mxCell>
