        </mxCell>

        <mxCell id="p1-gate1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=6;" value="_text_stage_semaphore&lt;br&gt;BoundedSemaphore(TEXT_STAGE_CONCURRENCY=8)" vertex="1">
