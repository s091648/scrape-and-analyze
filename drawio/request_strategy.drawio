        <mxCell id="p4-cbbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="RAG RPD circuit breaker" vertex="1">
          <mxGeometry x="40" y="580" width="960" height="200" as="geometry" />
        </mxCell>
        <mxCell id="p4-cb1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" value="First RpdExhausted / untyped 429 &#8594; _rag_rate_limited = True&lt;br&gt;&#8594; every remaining RAG task is skipped, bulk-written to the FailedTask ledger &#8594; picked up later by the RAG-backfill cron&lt;br&gt;rpm/tpm exceptions stay transient &#8212; fail only that one article" vertex="1">
          <mxGeometry x="60" y="620" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p4-cb2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="Per-article RAG backstop&lt;br&gt;asyncio.wait_for(coro, timeout=RAG_INGEST_TIMEOUT_SECONDS=900)&lt;br&gt;&#8212; hard wall-clock cap regardless of circuit-breaker state" vertex="1">
          <mxGeometry x="540" y="620" width="460" height="140" as="geometry" />
        </mxCell>

        <mxCell id="p4-dbbg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontStyle=1;fontSize=13;" value="Async DB pool &amp; event-loop executor &#8212; database.py / main.py" vertex="1">
          <mxGeometry x="40" y="810" width="960" height="330" as="geometry" />
        </mxCell>
        <mxCell id="p4-db1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="Bounded QueuePool (NOT NullPool)&lt;br&gt;ASYNC_DB_POOL_SIZE=10 + ASYNC_DB_MAX_OVERFLOW=10 = 20 hard cap&lt;br&gt;ASYNC_DB_POOL_TIMEOUT=120s &#183; pool_recycle=1800s &#183; pool_pre_ping=True" vertex="1">
          <mxGeometry x="60" y="850" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-db2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="prewarm_async_engine()&lt;br&gt;opens &amp; returns POOL_SIZE connections before Barrier-1's first fan-out &#8212; avoids a cold-connect burst" vertex="1">
          <mxGeometry x="540" y="850" width="460" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4-db3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="dispose_async_engine()&lt;br&gt;called in finally, inside the same asyncio.run() event loop, before teardown" vertex="1">
          <mxGeometry x="60" y="980" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-db4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=6;" value="Event loop default executor (main.py)&lt;br&gt;ThreadPoolExecutor(PIPELINE_EXECUTOR_MAX_WORKERS=32)&lt;br&gt;runs asyncio.getaddrinfo (DNS) + every asyncio.to_thread call &#8212; default size (~5-6) was starved by the scraper+RAG SDK cold-connect burst" vertex="1">
          <mxGeometry x="540" y="960" width="460" height="140" as="geometry" />
        </mxCell>
      </root>
