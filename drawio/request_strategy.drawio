        <mxCell id="p1-process" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="Process &#8594; Analyze &#8594; Translate&lt;br&gt;ProcessScrapedArticleUseCase &#8594; AnalyzeArticleUseCase (AsyncResilientLLMService, see p.3) &#8594; auto-translate (AnalysisCompletedHandler)" vertex="1">
          <mxGeometry x="60" y="850" width="420" height="90" as="geometry" />
        </mxCell>
