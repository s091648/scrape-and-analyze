          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="p1-publish" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" value="&#9315; Publish&lt;br&gt;asyncio.Task per article, own AsyncSession + fresh AsyncInMemoryEventBus &#8212; ArticleScrapedEvent" vertex="1">
          <mxGeometry x="60" y="610" width="880" height="70" as="geometry" />
        </mxCell>
