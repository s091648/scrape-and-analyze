                <mxCell id="f_s1_c" value="&lt;b&gt;CollectionPipeline&lt;/b&gt;._build_discover_tasks()&lt;br/&gt;→ &lt;b&gt;ScraperSettingRepository&lt;/b&gt;.get_active_due() → &lt;b&gt;ScraperSetting&lt;/b&gt; (is_due() == True)&lt;br/&gt;→ &lt;b&gt;ScraperFactory&lt;/b&gt;.create_for(setting) → &lt;b&gt;BaseScraper&lt;/b&gt; (ArxivScraper | RssScraper | BlogScraper)&lt;br/&gt;→ &lt;b&gt;DiscoverTask&lt;/b&gt;.execute() → &lt;b&gt;BaseScraper&lt;/b&gt;.discover() → List[&lt;b&gt;ScrapeJob&lt;/b&gt;]&lt;br/&gt;→ &lt;b&gt;ScrapeExecutor&lt;/b&gt;._discover_worker(): 每個 source 建立 &lt;b&gt;FetchTask&lt;/b&gt; list" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s1" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="117" as="geometry"/>
                </mxCell>
                <mxCell id="f_a12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="f_s1" target="f_s2" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s2" value="Stage 2 — Pre-dedup" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;startSize=38;" parent="1" vertex="1">
                    <mxGeometry x="200" y="285" width="1000" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="f_s2_c" value="&lt;b&gt;CollectionPipeline&lt;/b&gt;._pre_dedup(fetch_tasks)&lt;br/&gt;→ &lt;b&gt;ArticleRepository&lt;/b&gt;.find_analyzed_url_hashes() → Set[str] (已分析 URL 的 hash)&lt;br/&gt;→ &lt;b&gt;UrlHash&lt;/b&gt;.from_url(job.url) 比對 hash set&lt;br/&gt;→ 過濾已存在的 URL → 回傳未分析的 List[&lt;b&gt;FetchTask&lt;/b&gt;]" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s2" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="f_a23" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="f_s2" target="f_s3" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s3" value="Stage 3 — Fetch (concurrent, 5 workers)" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;startSize=38;" parent="1" vertex="1">
                    <mxGeometry x="200" y="465" width="1000" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="f_s3_c" value="&lt;b&gt;ScrapeExecutor&lt;/b&gt;.run_streaming(discover_tasks, on_result)&lt;br/&gt;→ &lt;b&gt;QueueRouter&lt;/b&gt;.route(fetch_task) → &lt;b&gt;HostQueueMap&lt;/b&gt;.get_or_create(host) (per-host semaphore)&lt;br/&gt;→ _fetch_worker() 從 host queue 取出並執行 &lt;b&gt;FetchTask&lt;/b&gt;.execute()&lt;br/&gt;  • &lt;b&gt;ArxivScraper&lt;/b&gt;: ArxivClient.fetch_entries() + PdfParser.parse(pdf_url) → &lt;b&gt;ScrapedArticle&lt;/b&gt;&lt;br/&gt;  • &lt;b&gt;RssScraper&lt;/b&gt;: RssClient.fetch_feed() + HtmlArticleParser.fetch_and_parse() → &lt;b&gt;ScrapedArticle&lt;/b&gt;&lt;br/&gt;  • &lt;b&gt;BlogScraper&lt;/b&gt;: HttpClient.get() + HtmlArticleParser.parse() → &lt;b&gt;ScrapedArticle&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s3" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="142" as="geometry"/>
                </mxCell>
                <mxCell id="f_a34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="f_s3" target="f_s4" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s4" value="Stage 4 — Publish" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;startSize=38;" parent="1" vertex="1">
                    <mxGeometry x="200" y="695" width="1000" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="f_s4_c" value="&lt;b&gt;CollectionPipeline&lt;/b&gt;._publish_articles(scraped_articles)&lt;br/&gt;→ &lt;b&gt;ScrapedArticleDTO&lt;/b&gt;.from_scraped_article(article)&lt;br/&gt;→ &lt;b&gt;EventBus&lt;/b&gt;.publish(&lt;b&gt;ArticleScrapedEvent&lt;/b&gt;(dto)) → 觸發 ArticleScrapedHandler" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s4" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="62" as="geometry"/>
                </mxCell>
                <mxCell id="f_a45" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="f_s4" target="f_s5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s5" value="Stage 5 — Process (event-driven)" style="swimlane;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;startSize=38;" parent="1" vertex="1">
                    <mxGeometry x="200" y="845" width="1000" height="225" as="geometry"/>
                </mxCell>
                <mxCell id="f_s5_c" value="&lt;b&gt;ArticleScrapedHandler&lt;/b&gt;.handle(dto: ScrapedArticleDTO)&lt;br/&gt;→ &lt;b&gt;ProcessScrapedArticleUseCase&lt;/b&gt;.execute(dto) → &lt;b&gt;DedupService&lt;/b&gt;.find_existing(url) → &lt;b&gt;ArticleOutcome&lt;/b&gt;&lt;br/&gt;  • NEW: &lt;b&gt;ArticleRepository&lt;/b&gt;.save(article) → &lt;b&gt;Article&lt;/b&gt;&lt;br/&gt;         [arxiv] &lt;b&gt;ArxivMetadataRepository&lt;/b&gt;.save(meta) → &lt;b&gt;ArxivMetadata&lt;/b&gt;&lt;br/&gt;         &lt;b&gt;EventBus&lt;/b&gt;.publish(&lt;b&gt;ArticleProcessedEvent&lt;/b&gt;(article))&lt;br/&gt;  • DUPLICATE_NEEDS_ANALYSIS: &lt;b&gt;EventBus&lt;/b&gt;.publish(&lt;b&gt;ArticleProcessedEvent&lt;/b&gt;(article))&lt;br/&gt;  • DUPLICATE: 略過&lt;br/&gt;→ &lt;b&gt;PipelineStats&lt;/b&gt;.record(source, outcome: ArticleOutcome)" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s5" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="167" as="geometry"/>
                </mxCell>
                <mxCell id="f_a56" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="f_s5" target="f_s6" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s6" value="Stage 6 — Mark Scraped" style="swimlane;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;startSize=38;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1100" width="1000" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="f_s6_c" value="&lt;b&gt;CollectionPipeline&lt;/b&gt;._mark_scraped(settings)&lt;br/&gt;→ &lt;b&gt;ScraperSettingRepository&lt;/b&gt;.mark_scraped(source)&lt;br/&gt;→ 更新 &lt;b&gt;ScraperSetting&lt;/b&gt;.last_scraped_at = now()" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s6" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="f_a67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="f_s6" target="f_s7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f_s7" value="Stage 7 — Notify" style="swimlane;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;startSize=38;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1240" width="1000" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="f_s7_c" value="&lt;b&gt;EventBus&lt;/b&gt;.publish(&lt;b&gt;PipelineCompletedEvent&lt;/b&gt;(stats, duration_seconds))&lt;br/&gt;→ &lt;b&gt;OtelMetricsHandler&lt;/b&gt;.handle(event) → OpenTelemetry metrics (Grafana Cloud)&lt;br/&gt;→ &lt;b&gt;PipelineStats&lt;/b&gt;.snapshot() → List[&lt;b&gt;SourceStats&lt;/b&gt;] (per-source 統計)&lt;br/&gt;→ (可選) Telegram 通知" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;strokeColor=none;fillColor=none;" parent="f_s7" vertex="1">
                    <mxGeometry x="10" y="48" width="980" height="82" as="geometry"/>
                </mxCell>
                <mxCell id="f_leg_title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontStyle=1;fontSize=13;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1410" width="100" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="f_leg_infra" value="Infrastructure Layer" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="200" y="1445" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="f_leg_app" value="Application Layer" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="370" y="1445" width="150" height="30" as="geometry"/>
                </mxCell>
            </root>
