        <mxCell id="fe_fcb" parent="fe_bg" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" value="FloatingChatbot&#xa;──────────────────────&#xa;apiUrl: string&#xa;sessionId: string&#xa;authToken?: string | null&#xa;topicId?: string | null&#xa;theme?: &#39;light&#39; | &#39;dark&#39;&#xa;initialOpen?: boolean&#xa;position?: bottom-right | bottom-left&#xa;──────────────────────&#xa;onOpen?(): void&#xa;onClose?(): void" vertex="1">
