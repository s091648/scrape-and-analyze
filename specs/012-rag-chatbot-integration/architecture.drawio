        <mxCell id="pg_table" parent="pg_bg" style="rounded=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=10;" value="article_chunks&#xa;────────────────────────&#xa;id            uuid  PK&#xa;article_id    uuid  FK → articles.id&#xa;chunk_index   int&#xa;content       text&#xa;embedding     vector(1536)&#xa;source_url    text&#xa;created_at    timestamptz&#xa;────────────────────────&#xa;UNIQUE(article_id, chunk_index)&#xa;INDEX ivfflat ON embedding" vertex="1">
