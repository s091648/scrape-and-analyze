          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a4" edge="1" parent="1" source="sdk_qry_bg" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" target="pg_table" value="cosine search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a5" edge="1" parent="1" source="be_rl" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;" target="redis_bg" value="INCR / GET / EXPIRE">
