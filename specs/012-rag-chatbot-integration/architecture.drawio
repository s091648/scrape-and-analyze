          <mxGeometry x="780" y="40" width="580" height="160" as="geometry" />
        </mxCell>

        <mxCell id="fe_iqa" value="InlineQABar&#xa;──────────────────────&#xa;apiUrl: string&#xa;sessionId: string&#xa;authToken?: string | null&#xa;topicId?: string | null&#xa;lang?: string&#xa;placeholder?: string&#xa;──────────────────────&#xa;onAnswer?(msg: ChatMessage): void&#xa;onError?(err: Error): void" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="fe_bg">
