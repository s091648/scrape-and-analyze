        </mxCell>
        <mxCell id="proxy" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" value="Next.js API Proxy&#xa;/api/proxy/[...path]" vertex="1">
          <mxGeometry height="60" width="200" x="870" y="290" as="geometry" />
        </mxCell>
        <mxCell id="a1" edge="1" parent="1" source="vhandler" style="edgeStyle=orthogonalEdgeStyle;fontSize=10;exitX=0.5;exitY=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="sdk_ing_bg" value="ingest(fulltext, {article_id, url, topic_id})">
