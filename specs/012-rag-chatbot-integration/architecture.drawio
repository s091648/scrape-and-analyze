          <mxGeometry height="330" width="580" x="790" y="410" as="geometry" />
        </mxCell>
        <mxCell id="be_ep1" parent="be_bg" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" value="POST /chat/query   →  SSE Stream&#xa;────────────────────────────────────&#xa;Request body:&#xa;  question:   string&#xa;  session_id: string&#xa;  history:    Message[]&#xa;  topic_id?:  string | null&#xa;────────────────────────────────────&#xa;SSE event types:&#xa;  { type: &quot;delta&quot;,  text: string }&#xa;  { type: &quot;source&quot;, url, title }&#xa;  { type: &quot;done&quot;,   usage: {tokens} }&#xa;  { type: &quot;error&quot;,  message: string }" vertex="1">
          <mxGeometry height="190" width="320" x="20" y="45" as="geometry" />
        </mxCell>
        <mxCell id="be_ep23" parent="be_bg" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" value="GET  /chat/session/{id}/history&#xa;DELETE /chat/session/{id}" vertex="1">
          <mxGeometry height="55" width="320" x="20" y="250" as="geometry" />
        </mxCell>
        <mxCell id="be_rl" parent="be_bg" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" value="Rate Limiter (Redis)&#xa;────────────────────────&#xa;guest  →  __rag_gid cookie UUID  →  3 RPD&#xa;user   →  user_id                →  50 RPD&#xa;admin  →  bypass                 →  unlimited&#xa;────────────────────────&#xa;Cookie: HttpOnly, SameSite=Lax&#xa;Max-Age: 31536000 (1 year)&#xa;Fallback: hash(IP + User-Agent)" vertex="1">
          <mxGeometry height="215" width="200" x="360" y="45" as="geometry" />
        </mxCell>
        <mxCell id="fe_bg" parent="1" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" value="🖥️ Frontend React Package (npm)" vertex="1">
          <mxGeometry height="215" width="580" x="680" y="25" as="geometry" />
        </mxCell>
        <mxCell id="fe_iqa" parent="fe_bg" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" value="InlineQABar&#xa;──────────────────────&#xa;apiUrl: string&#xa;sessionId: string&#xa;authToken?: string | null&#xa;topicId?: string | null&#xa;lang?: string&#xa;placeholder?: string&#xa;──────────────────────&#xa;onAnswer?(msg: ChatMessage): void&#xa;onError?(err: Error): void" vertex="1">
