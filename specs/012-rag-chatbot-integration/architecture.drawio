          <mxGeometry x="780" y="220" width="580" height="330" as="geometry" />
        </mxCell>

        <mxCell id="be_ep1" value="POST /chat/query   →  SSE Stream&#xa;────────────────────────────────────&#xa;Request body:&#xa;  question:   string&#xa;  session_id: string&#xa;  history:    Message[]&#xa;  topic_id?:  string | null&#xa;────────────────────────────────────&#xa;SSE event types:&#xa;  { type: &quot;delta&quot;,  text: string }&#xa;  { type: &quot;source&quot;, url, title }&#xa;  { type: &quot;done&quot;,   usage: {tokens} }&#xa;  { type: &quot;error&quot;,  message: string }" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="be_bg">
          <mxGeometry x="20" y="45" width="320" height="190" as="geometry" />
        </mxCell>

        <mxCell id="be_ep23" value="GET  /chat/session/{id}/history&#xa;DELETE /chat/session/{id}" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="be_bg">
          <mxGeometry x="20" y="250" width="320" height="55" as="geometry" />
        </mxCell>

        <mxCell id="be_rl" value="Rate Limiter (Redis)&#xa;────────────────────────&#xa;guest  →  __rag_gid cookie UUID  →  3 RPD&#xa;user   →  user_id                →  50 RPD&#xa;admin  →  bypass                 →  unlimited&#xa;────────────────────────&#xa;Cookie: HttpOnly, SameSite=Lax&#xa;Max-Age: 31536000 (1 year)&#xa;Fallback: hash(IP + User-Agent)" style="rounded=1;whiteSpace=wrap;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="be_bg">
          <mxGeometry x="360" y="45" width="200" height="215" as="geometry" />
        </mxCell>

